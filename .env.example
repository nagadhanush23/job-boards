# ==============================================================================
# Job-Boards Scraper & Web UI Configuration
# ==============================================================================

# Contact identification header sent with outbound HTTP requests.
# Internet Archive, urlscan, and posting APIs ask clients to identify their traffic.
# Use your real contact address (e.g. yourname@gmail.com).
JOB_SCRAPER_CONTACT=your-email@example.com

# Local Web UI Server Port (default: 8000)
PORT=8000

# SQLite database file path (default: job-boards.db)
DB_PATH=job-boards.db

